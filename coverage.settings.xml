<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage scope. The figure is meant to describe code someone maintains, so the test assembly and
  everything a generator emitted are excluded. Our own codegen marks its output with
  GeneratedCodeAttribute and ExcludeFromCodeCoverageAttribute, which the attribute rules below pick
  up; the source rules catch generator output we do not control, which lands in obj as .g.cs.
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <ModulePath>.*\.Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*\.g\.cs$</Source>
        <Source>.*\obj\.*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
